generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TripStatus {
  DRAFT
  COMPLETE
}

enum TravelCabinClass {
  ECONOMY
  PREMIUM_ECONOMY
  BUSINESS
  FIRST
}

enum FlightSelectionStrategy {
  CHEAPEST
  SHORTEST
  FEWEST_STOPS
  BEST_VALUE
}

enum HotelSelectionStrategy {
  CHEAPEST
  REFUNDABLE
  NEAREST_TO_ITINERARY
  BEST_VALUE
}

enum TripOfferSelectionStatus {
  SELECTED
  EXPIRED
  REPLACED
  INVALIDATED
}

enum TripOfferSelectionSource {
  USER_SELECTED
  SYSTEM_RECOMMENDED
}

enum TripBudgetSnapshotStatus {
  CURRENT
  SUPERSEDED
  STALE
  INCOMPLETE
}

enum DestinationImportSource {
  OPENSTREETMAP
  WIKIVOYAGE
  WIKIPEDIA
  GOVERNMENT_TOURISM
}

enum DestinationImportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum DestinationEnrichmentStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum DestinationBudgetLevel {
  FREE
  BUDGET
  MODERATE
  PREMIUM
  LUXURY
}

enum DestinationSetting {
  INDOOR
  OUTDOOR
  MIXED
}

enum DestinationFactEntityType {
  ATTRACTION
  RESTAURANT
  HOTEL
  ACTIVITY
}

enum DestinationFactType {
  OPENING_HOURS
  TICKET_PRICE
  ADDRESS
  COORDINATES
  OFFICIAL_URL
  OPERATIONAL_STATUS
  VISIT_DURATION
  DESCRIPTION_TAGS
}

enum DestinationFactSourceTier {
  OFFICIAL_SOURCE
  GOVERNMENT_OPEN_DATA
  OPENSTREETMAP_STRUCTURED
  TRUSTED_TRAVEL_LISTING
  GEMINI_DERIVED
}

enum DestinationFactStatus {
  ACTIVE
  STALE
  INVALID
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile Profile?
  trips   Trip[]

  @@map("users")
}

model Profile {
  id                String   @id @default(uuid())
  userId            String   @unique
  displayName       String   @db.VarChar(100)
  avatarUrl         String?
  country           String?  @db.VarChar(100)
  region            String?  @db.VarChar(100)
  preferredCurrency String?  @db.VarChar(3)
  travelInterests   String[] @default([])
  preferredLanguage String?  @db.VarChar(20)
  profileComplete   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Trip {
  id                   String     @id @default(uuid())
  userId               String
  title                String     @db.VarChar(200)
  status               TripStatus @default(DRAFT)
  itineraryJson        Json?
  itineraryEditVersion Int        @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user               User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  preferenceSet      PreferenceSet?
  travelProfile      TripTravelProfile?
  flightSelections   TripFlightSelection[]
  hotelSelections    TripHotelSelection[]
  budgetSnapshots    TripBudgetSnapshot[]
  itineraryRevisions ItineraryRevision[]

  @@map("trips")
}

model ItineraryRevision {
  id              String   @id @default(uuid())
  tripId          String
  revisionNumber  Int
  editVersion     Int
  actionType      String   @db.VarChar(40)
  actionSummary   String   @db.VarChar(240)
  itineraryJson   Json
  createdByUserId String
  createdAt       DateTime @default(now())

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@unique([tripId, revisionNumber])
  @@index([tripId, createdAt])
  @@map("itinerary_revisions")
}

model PreferenceSet {
  id                       String   @id @default(uuid())
  tripId                   String   @unique
  destination              String?  @db.VarChar(200)
  budget                   Int?
  travelStyles             String[] @default([])
  foodPreferences          String[] @default([])
  accommodationType        String?
  transportationPreference String?
  activityPreferences      String[] @default([])
  groupSize                Int?
  durationDays             Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("preference_sets")
}

model TripTravelProfile {
  id                          String                  @id @default(uuid())
  tripId                      String                  @unique
  originCity                  String?                 @db.VarChar(160)
  originCountry               String?                 @db.VarChar(120)
  originAirportCode           String?                 @db.VarChar(3)
  destinationAirportCode      String?                 @db.VarChar(3)
  departureDate               DateTime?               @db.Date
  returnDate                  DateTime?               @db.Date
  adults                      Int                     @default(1)
  children                    Int                     @default(0)
  infants                     Int                     @default(0)
  rooms                       Int                     @default(1)
  cabinClass                  TravelCabinClass        @default(ECONOMY)
  nonStopOnly                 Boolean                 @default(false)
  currency                    String?                 @db.VarChar(3)
  flightSelectionStrategy     FlightSelectionStrategy @default(BEST_VALUE)
  hotelSelectionStrategy      HotelSelectionStrategy  @default(BEST_VALUE)
  selectedOutboundFlightId    String?                 @db.VarChar(220)
  selectedReturnFlightId      String?                 @db.VarChar(220)
  selectedHotelId             String?                 @db.VarChar(220)
  selectionFingerprint        String?                 @db.VarChar(64)
  selectionFingerprintVersion Int?
  selectionProvider           String?                 @db.VarChar(40)
  selectionReviewedAt         DateTime?
  selectionVersion            Int                     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([originAirportCode, destinationAirportCode])
  @@index([departureDate, returnDate])
  @@map("trip_travel_profiles")
}

model TripFlightSelection {
  id                     String                   @id @default(uuid())
  tripId                 String
  offerId                String                   @db.VarChar(220)
  providerKey            String                   @db.VarChar(80)
  providerOfferId        String                   @db.VarChar(220)
  searchFingerprint      String                   @db.VarChar(64)
  originAirportCode      String                   @db.VarChar(3)
  destinationAirportCode String                   @db.VarChar(3)
  departureDate          DateTime                 @db.Date
  returnDate             DateTime?                @db.Date
  itinerarySummary       Json
  originalAmount         Decimal                  @db.Decimal(18, 2)
  originalCurrency       String                   @db.VarChar(3)
  convertedAmount        Decimal?                 @db.Decimal(18, 2)
  convertedCurrency      String?                  @db.VarChar(3)
  conversionRate         Decimal?                 @db.Decimal(18, 8)
  conversionTimestamp    DateTime?
  baggageSummary         Json?
  refundable             Boolean?
  fetchedAt              DateTime
  providerExpiresAt      DateTime?
  selectedAt             DateTime                 @default(now())
  status                 TripOfferSelectionStatus @default(SELECTED)
  selectionSource        TripOfferSelectionSource @default(USER_SELECTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip            Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  budgetSnapshots TripBudgetSnapshot[] @relation("FlightSelectionBudgetSnapshots")

  @@index([tripId, status])
  @@index([searchFingerprint])
  @@index([providerKey, providerOfferId])
  @@map("trip_flight_selections")
}

model TripHotelSelection {
  id                  String                   @id @default(uuid())
  tripId              String
  offerId             String                   @db.VarChar(220)
  providerKey         String                   @db.VarChar(80)
  providerOfferId     String                   @db.VarChar(220)
  searchFingerprint   String                   @db.VarChar(64)
  propertyId          String                   @db.VarChar(220)
  propertyName        String                   @db.VarChar(240)
  coordinates         Json?
  checkInDate         DateTime                 @db.Date
  checkOutDate        DateTime                 @db.Date
  roomSummary         Json?
  boardType           String?                  @db.VarChar(80)
  originalAmount      Decimal                  @db.Decimal(18, 2)
  originalCurrency    String                   @db.VarChar(3)
  convertedAmount     Decimal?                 @db.Decimal(18, 2)
  convertedCurrency   String?                  @db.VarChar(3)
  conversionRate      Decimal?                 @db.Decimal(18, 8)
  conversionTimestamp DateTime?
  refundable          Boolean?
  fetchedAt           DateTime
  providerExpiresAt   DateTime?
  selectedAt          DateTime                 @default(now())
  status              TripOfferSelectionStatus @default(SELECTED)
  selectionSource     TripOfferSelectionSource @default(USER_SELECTED)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip            Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  budgetSnapshots TripBudgetSnapshot[] @relation("HotelSelectionBudgetSnapshots")

  @@index([tripId, status])
  @@index([searchFingerprint])
  @@index([providerKey, providerOfferId])
  @@map("trip_hotel_selections")
}

model TripBudgetSnapshot {
  id                       String                   @id @default(uuid())
  tripId                   String
  currency                 String                   @db.VarChar(3)
  flight                   Json
  accommodation            Json
  attractions              Json
  food                     Json
  localTransport           Json
  contingency              Json
  totalAmount              Decimal?                 @db.Decimal(18, 2)
  perPersonAmount          Decimal?                 @db.Decimal(18, 2)
  assumptions              Json
  missingData              Json
  selectedFlightSnapshotId String?
  selectedHotelSnapshotId  String?
  calculatedAt             DateTime
  status                   TripBudgetSnapshotStatus @default(CURRENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip                   Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  selectedFlightSnapshot TripFlightSelection? @relation("FlightSelectionBudgetSnapshots", fields: [selectedFlightSnapshotId], references: [id], onDelete: SetNull)
  selectedHotelSnapshot  TripHotelSelection?  @relation("HotelSelectionBudgetSnapshots", fields: [selectedHotelSnapshotId], references: [id], onDelete: SetNull)

  @@index([tripId, status])
  @@index([selectedFlightSnapshotId])
  @@index([selectedHotelSnapshotId])
  @@map("trip_budget_snapshots")
}

model ExchangeRate {
  id            String   @id @default(uuid())
  baseCurrency  String   @db.VarChar(3)
  quoteCurrency String   @db.VarChar(3)
  rate          Decimal  @db.Decimal(18, 8)
  source        String   @db.VarChar(50)
  fetchedAt     DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([baseCurrency, quoteCurrency])
  @@index([baseCurrency, quoteCurrency, fetchedAt])
  @@map("exchange_rates")
}

model Country {
  id           String    @id @default(uuid())
  name         String    @db.VarChar(120)
  slug         String    @unique @db.VarChar(140)
  iso2         String    @unique @db.VarChar(2)
  iso3         String?   @unique @db.VarChar(3)
  currencyCode String?   @db.VarChar(3)
  phoneCode    String?   @db.VarChar(20)
  description  String?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  cities City[]
  images DestinationImage[]
  tags   DestinationTag[]   @relation("CountryDestinationTags")

  @@index([name])
  @@index([deletedAt])
  @@map("countries")
}

model City {
  id          String    @id @default(uuid())
  countryId   String
  name        String    @db.VarChar(160)
  slug        String    @db.VarChar(180)
  region      String?   @db.VarChar(160)
  latitude    Decimal?  @db.Decimal(10, 7)
  longitude   Decimal?  @db.Decimal(10, 7)
  timezone    String?   @db.VarChar(80)
  description String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  country     Country            @relation(fields: [countryId], references: [id], onDelete: Restrict)
  attractions Attraction[]
  restaurants Restaurant[]
  hotels      Hotel[]
  activities  Activity[]
  images      DestinationImage[]
  tags        DestinationTag[]   @relation("CityDestinationTags")

  @@unique([countryId, slug])
  @@index([countryId])
  @@index([name])
  @@index([slug])
  @@index([deletedAt])
  @@map("cities")
}

model Attraction {
  id              String    @id @default(uuid())
  cityId          String
  name            String    @db.VarChar(200)
  slug            String    @db.VarChar(220)
  description     String?
  address         String?
  latitude        Decimal?  @db.Decimal(10, 7)
  longitude       Decimal?  @db.Decimal(10, 7)
  websiteUrl      String?
  phone           String?   @db.VarChar(50)
  priceLevel      Int?
  durationMinutes Int?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  city         City                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  images       DestinationImage[]
  openingHours OpeningHour[]
  tags         DestinationTag[]       @relation("AttractionDestinationTags")
  enrichment   DestinationEnrichment?

  @@unique([cityId, slug])
  @@index([cityId])
  @@index([name])
  @@index([slug])
  @@index([deletedAt])
  @@map("attractions")
}

model Restaurant {
  id             String    @id @default(uuid())
  cityId         String
  name           String    @db.VarChar(200)
  slug           String    @db.VarChar(220)
  description    String?
  address        String?
  latitude       Decimal?  @db.Decimal(10, 7)
  longitude      Decimal?  @db.Decimal(10, 7)
  websiteUrl     String?
  phone          String?   @db.VarChar(50)
  cuisines       String[]  @default([])
  priceLevel     Int?
  reservationUrl String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  city         City                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  images       DestinationImage[]
  openingHours OpeningHour[]
  tags         DestinationTag[]       @relation("RestaurantDestinationTags")
  enrichment   DestinationEnrichment?

  @@unique([cityId, slug])
  @@index([cityId])
  @@index([name])
  @@index([slug])
  @@index([deletedAt])
  @@map("restaurants")
}

model Hotel {
  id           String    @id @default(uuid())
  cityId       String
  name         String    @db.VarChar(200)
  slug         String    @db.VarChar(220)
  description  String?
  address      String?
  latitude     Decimal?  @db.Decimal(10, 7)
  longitude    Decimal?  @db.Decimal(10, 7)
  websiteUrl   String?
  phone        String?   @db.VarChar(50)
  starRating   Decimal?  @db.Decimal(2, 1)
  amenities    String[]  @default([])
  checkInTime  String?   @db.VarChar(5)
  checkOutTime String?   @db.VarChar(5)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  city         City                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  images       DestinationImage[]
  openingHours OpeningHour[]
  tags         DestinationTag[]       @relation("HotelDestinationTags")
  enrichment   DestinationEnrichment?

  @@unique([cityId, slug])
  @@index([cityId])
  @@index([name])
  @@index([slug])
  @@index([deletedAt])
  @@map("hotels")
}

model Activity {
  id              String    @id @default(uuid())
  cityId          String
  name            String    @db.VarChar(200)
  slug            String    @db.VarChar(220)
  description     String?
  category        String?   @db.VarChar(100)
  address         String?
  latitude        Decimal?  @db.Decimal(10, 7)
  longitude       Decimal?  @db.Decimal(10, 7)
  websiteUrl      String?
  phone           String?   @db.VarChar(50)
  priceLevel      Int?
  durationMinutes Int?
  minAge          Int?
  difficulty      String?   @db.VarChar(50)
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  city         City                   @relation(fields: [cityId], references: [id], onDelete: Restrict)
  images       DestinationImage[]
  openingHours OpeningHour[]
  tags         DestinationTag[]       @relation("ActivityDestinationTags")
  enrichment   DestinationEnrichment?

  @@unique([cityId, slug])
  @@index([cityId])
  @@index([name])
  @@index([slug])
  @@index([category])
  @@index([deletedAt])
  @@map("activities")
}

model DestinationTag {
  id          String    @id @default(uuid())
  name        String    @db.VarChar(100)
  slug        String    @unique @db.VarChar(120)
  description String?
  color       String?   @db.VarChar(20)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  countries   Country[]    @relation("CountryDestinationTags")
  cities      City[]       @relation("CityDestinationTags")
  attractions Attraction[] @relation("AttractionDestinationTags")
  restaurants Restaurant[] @relation("RestaurantDestinationTags")
  hotels      Hotel[]      @relation("HotelDestinationTags")
  activities  Activity[]   @relation("ActivityDestinationTags")

  @@index([name])
  @@index([deletedAt])
  @@map("destination_tags")
}

model DestinationImage {
  id             String    @id @default(uuid())
  countryId      String?
  cityId         String?
  attractionId   String?
  restaurantId   String?
  hotelId        String?
  activityId     String?
  url            String
  altText        String?   @db.VarChar(255)
  caption        String?   @db.VarChar(255)
  attribution    String?   @db.VarChar(255)
  sourceProvider String?   @db.VarChar(80)
  sourceRecordId String?   @db.VarChar(255)
  sourceUrl      String?
  pageUrl        String?
  author         String?   @db.VarChar(255)
  licenseName    String?   @db.VarChar(120)
  licenseUrl     String?
  sortOrder      Int       @default(0)
  isPrimary      Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  country    Country?    @relation(fields: [countryId], references: [id], onDelete: Cascade)
  city       City?       @relation(fields: [cityId], references: [id], onDelete: Cascade)
  attraction Attraction? @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  hotel      Hotel?      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  activity   Activity?   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([countryId])
  @@index([cityId])
  @@index([attractionId])
  @@index([restaurantId])
  @@index([hotelId])
  @@index([activityId])
  @@index([isPrimary])
  @@index([deletedAt])
  @@map("destination_images")
}

model DestinationSourceProvenance {
  id                String                    @id @default(uuid())
  entityType        DestinationFactEntityType
  entityId          String
  sourceProvider    String                    @db.VarChar(80)
  sourceRecordId    String                    @db.VarChar(255)
  sourceUrl         String?
  sourceLicenseName String?                   @db.VarChar(120)
  sourceLicenseUrl  String?
  attribution       String?
  externalIds       Json?
  rawPayload        Json?
  importConfidence  Int?
  duplicateStatus   String?                   @db.VarChar(40)
  manuallyCurated   Boolean                   @default(false)
  lastSourceSyncAt  DateTime?
  sourceContentHash String?                   @db.VarChar(80)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@unique([sourceProvider, sourceRecordId])
  @@index([entityType, entityId])
  @@index([sourceProvider])
  @@index([lastSourceSyncAt])
  @@map("destination_source_provenance")
}

model DestinationFact {
  id              String                    @id @default(uuid())
  entityType      DestinationFactEntityType
  entityId        String
  factType        DestinationFactType
  normalizedValue Json
  rawValue        Json?
  currency        String?                   @db.VarChar(3)
  sourceKey       String                    @db.VarChar(100)
  sourceUrl       String?
  sourceRecordId  String?                   @db.VarChar(255)
  sourceTier      DestinationFactSourceTier
  confidence      Int                       @default(100)
  retrievedAt     DateTime
  verifiedAt      DateTime?
  expiresAt       DateTime?
  parserVersion   String?                   @db.VarChar(100)
  status          DestinationFactStatus     @default(ACTIVE)
  fingerprint     String                    @unique @db.VarChar(80)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([entityType, entityId])
  @@index([entityType, entityId, factType, status])
  @@index([factType, status])
  @@index([sourceKey, sourceRecordId])
  @@index([sourceTier, verifiedAt])
  @@index([expiresAt])
  @@map("destination_facts")
}

model OpeningHour {
  id           String    @id @default(uuid())
  attractionId String?
  restaurantId String?
  hotelId      String?
  activityId   String?
  dayOfWeek    Int
  opensAt      String?   @db.VarChar(5)
  closesAt     String?   @db.VarChar(5)
  isClosed     Boolean   @default(false)
  note         String?   @db.VarChar(255)
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attraction Attraction? @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  hotel      Hotel?      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  activity   Activity?   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([attractionId])
  @@index([restaurantId])
  @@index([hotelId])
  @@index([activityId])
  @@index([dayOfWeek])
  @@index([deletedAt])
  @@map("opening_hours")
}

model DestinationImportJob {
  id               String                  @id @default(uuid())
  source           DestinationImportSource
  sourceKey        String                  @db.VarChar(255)
  status           DestinationImportStatus @default(PENDING)
  cursor           Int                     @default(0)
  totalRecords     Int                     @default(0)
  processedRecords Int                     @default(0)
  skippedRecords   Int                     @default(0)
  failedRecords    Int                     @default(0)
  config           Json?
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([source, sourceKey])
  @@index([source])
  @@index([status])
  @@index([updatedAt])
  @@map("destination_import_jobs")
}

model DestinationEnrichment {
  id                            String                 @id @default(uuid())
  attractionId                  String?                @unique
  restaurantId                  String?                @unique
  hotelId                       String?                @unique
  activityId                    String?                @unique
  shortSummary                  String                 @db.VarChar(600)
  bestFor                       String[]               @default([])
  hiddenGemScore                Int
  photographyScore              Int
  familyFriendly                Boolean
  coupleFriendly                Boolean
  kidsFriendly                  Boolean
  budgetLevel                   DestinationBudgetLevel
  estimatedVisitDurationMinutes Int
  bestVisitingHours             String[]               @default([])
  indoorOutdoor                 DestinationSetting
  rainFriendly                  Boolean
  searchTags                    String[]               @default([])
  provider                      String                 @db.VarChar(50)
  model                         String                 @db.VarChar(100)
  generatedAt                   DateTime               @default(now())
  createdAt                     DateTime               @default(now())
  updatedAt                     DateTime               @updatedAt

  attraction Attraction? @relation(fields: [attractionId], references: [id], onDelete: Cascade)
  restaurant Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  hotel      Hotel?      @relation(fields: [hotelId], references: [id], onDelete: Cascade)
  activity   Activity?   @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([hiddenGemScore])
  @@index([photographyScore])
  @@index([familyFriendly])
  @@index([coupleFriendly])
  @@index([kidsFriendly])
  @@index([budgetLevel])
  @@index([indoorOutdoor])
  @@index([rainFriendly])
  @@index([generatedAt])
  @@map("destination_enrichments")
}

model DestinationEnrichmentJob {
  id               String                      @id @default(uuid())
  sourceKey        String                      @unique @db.VarChar(255)
  status           DestinationEnrichmentStatus @default(PENDING)
  batchSize        Int                         @default(25)
  processedRecords Int                         @default(0)
  skippedRecords   Int                         @default(0)
  failedRecords    Int                         @default(0)
  errorMessage     String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([status])
  @@index([updatedAt])
  @@map("destination_enrichment_jobs")
}
