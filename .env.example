# =============================================================================
# Roamly - Environment Variables
# Copy this file to .env.local and fill in all values.
# NEVER commit .env.local to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database (Supabase PostgreSQL via Prisma)
# Use Supavisor transaction pooling for app runtime queries.
# Get this from: Supabase Dashboard -> Connect -> Transaction pooler.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Use the direct database URL when reachable, or Supavisor session pooling
# when the direct host is IPv6-only or unavailable from the local network.
# Get this from: Supabase Dashboard -> Connect -> Session pooler.
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-REGION].pooler.supabase.com:5432/postgres"

# -----------------------------------------------------------------------------
# Supabase (Auth + Storage)
# Get these from: Supabase Dashboard -> Project Settings -> API
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-ANON-KEY]"

# Service role key - server-side only, NEVER expose to the browser
SUPABASE_SERVICE_ROLE_KEY="[YOUR-SERVICE-ROLE-KEY]"
SUPABASE_AVATAR_BUCKET="avatars"

# -----------------------------------------------------------------------------
# AI Provider (Google Gemini)
# Get a Gemini API key from Google AI Studio: https://aistudio.google.com/app/apikey
# -----------------------------------------------------------------------------
GEMINI_API_KEY="[YOUR-GEMINI-API-KEY]"
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_REQUEST_TIMEOUT_MS="60000"
GEMINI_MAX_RETRIES="1"
GEMINI_RETRY_BASE_DELAY_MS="750"

# Which AI provider to use. Supported: "gemini"
# Defaults to "gemini" if not set.
AI_PROVIDER="gemini"

# -----------------------------------------------------------------------------
# Travel Offers and Budget
# Mock mode is deterministic and does not call live flight or hotel APIs.
# Do not add live provider keys until a provider has been selected.
# -----------------------------------------------------------------------------
TRAVEL_OFFER_MODE="mock"
FLIGHT_PROVIDER="mock"
HOTEL_PROVIDER="mock"
FLIGHT_OFFER_CACHE_TTL_SECONDS="900"
HOTEL_OFFER_CACHE_TTL_SECONDS="900"
TRAVEL_OFFER_CACHE_MAX_PAYLOAD_BYTES="256000"
MAX_TRAVELERS_PER_TRIP="18"
ALLOW_ROOMS_GREATER_THAN_TRAVELERS="false"
TRIP_BUDGET_CONTINGENCY_PERCENT="10"
DEFAULT_DAILY_FOOD_BUDGET="80.00"
DEFAULT_DAILY_LOCAL_TRANSPORT_BUDGET="30.00"

# -----------------------------------------------------------------------------
# Destination Import
# -----------------------------------------------------------------------------
GOVERNMENT_TOURISM_DATASET_URL="https://example.gov/dataset.json"

# Deprecated compatibility alias for GOVERNMENT_TOURISM_DATASET_URL.
# Prefer GOVERNMENT_TOURISM_DATASET_URL for new deployments.
DESTINATION_GOVERNMENT_DATASET_URL="https://example.gov/dataset.json"

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
